@model List<OnlineBookStore.Models.Order>

<section class="max-w-6xl mx-auto px-4 py-6">
    <h2 class="text-2xl font-semibold mb-6 border-b pb-2">My Orders</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="text-gray-500 text-center mt-10">
            You have no orders yet.
        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            <div class="bg-white border border-gray-200 rounded-sm shadow-sm mb-6 p-6">
                <div class="flex flex-col md:flex-row md:justify-between md:items-center mb-4">
                    <div>
                        <h3 class="text-lg font-semibold text-gray-800 mb-1">Order #@order.OrderId</h3>
                        <p class="text-sm text-gray-500">Placed on @order.OrderDate.ToString("MMMM dd, yyyy")</p>
                        <p class="text-sm text-gray-500">Claim Code: <span class="font-medium text-gray-700">@order.ClaimCode</span></p>
                    </div>
                    <div class="mt-3 md:mt-0">
                        <span class="inline-block px-3 py-1 text-sm rounded-full 
                            @(
                                order.Status == "Pending" ? "bg-yellow-100 text-yellow-700" :
                                order.Status == "Shipped" ? "bg-blue-100 text-blue-700" :
                                order.Status == "Delivered" ? "bg-green-100 text-green-700" :
                                "bg-gray-100 text-gray-700"
                            )">
                            @order.Status
                        </span>
                    </div>
                </div>

                <div class="mb-4">
                    <h4 class="text-md font-medium text-gray-700 mb-2">Items:</h4>
                    <ul class="divide-y divide-gray-200">
                        @foreach (var item in order.OrderItems)
                        {
                            <li class="py-2 flex justify-between items-center">
                                <span class="text-gray-800">@item.Book.Title</span>
                                <span class="text-sm text-gray-500">Qty: @item.Quantity × $@item.UnitPrice</span>
                            </li>
                        }
                    </ul>
                </div>

                <div class="flex justify-between items-center">
                    <div class="text-lg font-semibold text-gray-800">
                        Total: $@order.FinalAmount
                    </div>

                    @if (order.Status == "Pending")
                    {
                        <form asp-action="Cancel" asp-controller="Order" method="post">
                            <input type="hidden" name="orderId" value="@order.OrderId" />
                            <button type="submit"
                                    class="text-sm text-red-600 border border-red-300 hover:bg-red-50 px-4 py-1.5 rounded-md transition">
                                Cancel Order
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    }
</section>
