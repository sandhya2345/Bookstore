@model OnlineBookStore.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<div class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto bg-white rounded-lg shadow-md p-6">
        <img src="@Model.CoverImageUrl" alt="@Model.Title" class="w-full h-96 object-cover mb-6 rounded">
        <h1 class="text-3xl font-bold mb-2">@Model.Title</h1>
        <p class="text-gray-700 text-lg">by <strong>@Model.Author</strong></p>
        <p class="text-sm text-gray-500 mb-2">Genre: @Model.Genre | Language: @Model.Language</p>
        <p class="mt-4 text-gray-800">@Model.Description</p>
        <p class="mt-4 text-2xl font-bold text-green-700">$@Model.Price</p>
        <p class="mt-2 text-sm">Stock: @Model.StockQuantity</p>
        <a href="/Books/Browse" class="mt-6 inline-block text-blue-600 hover:underline">← Back to Browse</a>
    </div>
</div>
