@model OnlineBookStore.ViewModels.BookBrowseViewModel

@{
    ViewData["Title"] = "Browse Books";
    var currentSearch = Model.SearchTerm;
    var currentGenre = Model.Genre;
    var currentSort = Model.SortBy;
}

@if (TempData["Success"] != null)
{
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-6" role="alert">
        <strong class="font-bold">Success!</strong>
        <span class="block sm:inline">@TempData["Success"]</span>
    </div>
}

<div class="container mx-auto px-12 py-8">
    <!-- Header -->
    <div class="mb-6">
        <h1 class="text-3xl font-bold mb-2">Browse Books</h1>
        <p class="text-gray-600">
            Discover a wide range of books across various genres. Use the search bar, genre filter, and sorting options to find your next favorite read.
        </p>
    </div>

   
    <form method="get" asp-action="Browse" class="flex flex-col md:flex-row gap-4 mb-12">
        <div class="relative w-full md:w-1/3">
            <input type="text" name="searchTerm" value="@currentSearch"
                   placeholder="Search books..."
                   class="w-full border border-gray-300 rounded-md shadow-sm pl-10 pr-4 py-2 focus:outline-none focus:ring focus:border-blue-300" />
            <button type="submit" class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400">
                <i class="fas fa-search"></i>
            </button>
        </div>

        <!-- Genre Dropdown -->
        <div class="w-full md:w-1/3">
            <select id="genre" name="genre"
                    class="w-full border border-gray-300 rounded-md shadow-sm px-3 py-2 focus:outline-none focus:ring focus:border-blue-300"
                    onchange="this.form.submit()">
                <option value="">All Genres</option>
                @foreach (var g in Model.Genres)
                {
                    <option value="@g" selected="@(currentGenre == g ? "selected" : null)">@g</option>
                }
            </select>
        </div>

        <!-- Sort Dropdown -->
        <div class="w-full md:w-1/3">
            <select id="sortBy" name="sortBy"
                    class="w-full border border-gray-300 rounded-md shadow-sm px-3 py-2 focus:outline-none focus:ring focus:border-blue-300"
                    onchange="this.form.submit()">
                <option value="">Sort By</option>
                <option value="price_asc" selected="@(currentSort == "price_asc" ? "selected" : null)">Price: Low to High</option>
                <option value="price_desc" selected="@(currentSort == "price_desc" ? "selected" : null)">Price: High to Low</option>
                <option value="title" selected="@(currentSort == "title" ? "selected" : null)">Title</option>
            </select>
        </div>
    </form>
    
    <div class="w-full md:w-5/5 mx-auto">
    <!-- Book Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
        @foreach (var book in Model.Books)
        {
            <div class="bg-white rounded-sm hover:shadow-xl transition-transform duration-300 transform hover:scale-[1.02] flex flex-col overflow-hidden">
                        <a href="@Url.Action("Details", "Books", new { id = book.BookId })">
                            <img src="@book.CoverImageUrl" alt="@book.Title" class="w-full h-60 object-contain" />
                        </a>

                <div class="p-4 flex flex-col justify-between flex-1">
                    <div>
                        <h2 class="text-lg font-semibold text-gray-800 truncate">@book.Title</h2>
                        <p class="text-sm text-gray-600">by @book.Author</p>
                        <p class="text-xs text-gray-400 mt-1">@book.Genre</p>
                    </div>
                    <div class="mt-2">
                        <p class="text-lg font-bold text-gray-700">Rs. @book.Price</p>
                        <a href="@Url.Action("AddToCart", "Cart", new { id = book.BookId })"
                                   class="mt-2 block text-blue-700 border border-blue-500 text-center text-sm font-semibold px-4 py-2 rounded-sm
          hover:bg-blue-700 hover:text-white transition duration-200">
                            
                            ADD TO CART
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="mt-10 flex justify-center items-center space-x-2">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a href="@Url.Action("Browse", new {
                        searchTerm = currentSearch,
                        genre = currentGenre,
                        sortBy = currentSort,
                        page = i
                    })"
                   class="px-4 py-2 rounded-md border transition duration-200
                          @(i == Model.CurrentPage 
                            ? "bg-blue-600 text-white border-blue-600" 
                            : "bg-white text-gray-700 border-gray-300 hover:bg-gray-100")">
                    @i
                </a>
            }
        </div>
    }
</div>

    </div>
</div>
