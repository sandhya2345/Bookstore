@model OnlineBookStore.ViewModels.BookBrowseViewModel

@{
    ViewData["Title"] = "Browse Books";
    var currentSearch = Model.SearchTerm;
    var currentGenre = Model.Genre;
    var currentSort = Model.SortBy;
}

@if (TempData["Success"] != null)
{
    <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-6" role="alert">
        <strong class="font-bold">Success!</strong>
        <span class="block sm:inline">@TempData["Success"]</span>
    </div>
}

<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-6">Browse Books</h1>

    <div class="flex flex-col md:flex-row gap-8">
        <!-- Sidebar: Filters -->
        <aside class="w-full md:w-1/5 space-y-6">
            <form method="get" asp-action="Browse" class="space-y-4">
                <!-- Search -->
                <div>
                    <label for="searchTerm" class="block text-sm font-medium text-gray-700">Search</label>
                    <input type="text" id="searchTerm" name="searchTerm" value="@currentSearch"
                           class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm px-3 py-2 focus:outline-none focus:ring focus:border-blue-300" />
                </div>

                <!-- Genre -->
                <div>
                    <label for="genre" class="block text-sm font-medium text-gray-700">Genre</label>
                    <select id="genre" name="genre"
                            class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm px-3 py-2 focus:outline-none focus:ring focus:border-blue-300">
                        <option value="">All</option>
                        @foreach (var g in Model.Genres)
                        {
                            <option value="@g" selected="@(currentGenre == g ? "selected" : null)">@g</option>
                        }
                    </select>
                </div>

                <!-- Sort -->
                <div>
                    <label for="sortBy" class="block text-sm font-medium text-gray-700">Sort By</label>
                    <select id="sortBy" name="sortBy"
                            class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm px-3 py-2 focus:outline-none focus:ring focus:border-blue-300">
                        <option value="">Default</option>
                        <option value="price_asc" selected="@(currentSort == "price_asc" ? "selected" : null)">Price: Low to High</option>
                        <option value="price_desc" selected="@(currentSort == "price_desc" ? "selected" : null)">Price: High to Low</option>
                        <option value="title" selected="@(currentSort == "title" ? "selected" : null)">Title</option>
                    </select>
                </div>

                <!-- Submit -->
                <div>
                    <button type="submit"
                            class="w-full bg-dark-800 text-white px-4 py-2 rounded hover:bg-dark-800">
                        Apply Filters
                    </button>
                </div>
            </form>
        </aside>

        <!-- Main: Book Grid -->
       <div class="w-full md:w-4/5 mx-auto">
    <!-- Book Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
        @foreach (var book in Model.Books)
        {
            <div class="bg-white rounded-md hover:shadow-xl transition-transform duration-300 transform hover:scale-[1.02] flex flex-col overflow-hidden">
                <a href="@Url.Action("Details", "Books", new { id = book.BookId })">
                    <img src="@book.CoverImageUrl" alt="@book.Title" class="w-full h-40 object-cover" />
                </a>
                <div class="p-4 flex flex-col justify-between flex-1">
                    <div>
                        <h2 class="text-lg font-semibold text-gray-800 truncate">@book.Title</h2>
                        <p class="text-sm text-gray-600">by @book.Author</p>
                        <p class="text-xs text-gray-400 mt-1">@book.Genre</p>
                    </div>
                    <div class="mt-2">
                        <p class="text-lg font-bold text-green-600">Rs. @book.Price</p>
                        <a href="@Url.Action("AddToCart", "Cart", new { id = book.BookId })"
                           class="mt-2 block bg-blue-600 text-white text-center text-sm font-medium px-4 py-2 rounded-md hover:bg-blue-700 transition duration-200">
                            ADD TO CART
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="mt-10 flex justify-center items-center space-x-2">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a href="@Url.Action("Browse", new {
                        searchTerm = currentSearch,
                        genre = currentGenre,
                        sortBy = currentSort,
                        page = i
                    })"
                   class="px-4 py-2 rounded-md border transition duration-200
                          @(i == Model.CurrentPage 
                            ? "bg-blue-600 text-white border-blue-600" 
                            : "bg-white text-gray-700 border-gray-300 hover:bg-gray-100")">
                    @i
                </a>
            }
        </div>
    }
</div>

    </div>
</div>
