@{
    ViewData["Title"] = "Dashboard";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="text-center mb-12">
        <h1 class="text-3xl font-bold text-gray-900">
            <i class="fas fa-tachometer-alt mr-2"></i> Welcome to Your Dashboard
        </h1>
        <p class="mt-4 text-lg text-gray-600">
            Hello, @User.Identity.Name! You're now logged in to OnlineBookStore.
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white p-6 rounded-lg shadow-md">
            <div class="text-indigo-600 text-4xl mb-4">
                <i class="fas fa-book"></i>
            </div>
            <h3 class="text-xl font-semibold mb-2">Browse Books</h3>
            <p class="text-gray-600 mb-4">Explore our extensive collection of books.</p>
            <a href="/Books/Browse" class="text-indigo-600 hover:text-indigo-800 font-medium">
                View Catalog <i class="fas fa-arrow-right ml-1"></i>
            </a>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-md">
            <div class="text-indigo-600 text-4xl mb-4">
                <i class="fas fa-heart text-pink-500"></i>
            </div>
            <h3 class="text-xl font-semibold mb-2">Your Wishlist</h3>
            <p class="text-gray-600 mb-4">View and manage your saved books.</p>
            <a href="#" class="text-indigo-600 hover:text-indigo-800 font-medium">
                View Wishlist <i class="fas fa-arrow-right ml-1"></i>
            </a>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-md">
            <div class="text-indigo-600 text-4xl mb-4">
                <i class="fas fa-history"></i>
            </div>
            <h3 class="text-xl font-semibold mb-2">Order History</h3>
            <p class="text-gray-600 mb-4">Track your previous orders.</p>
            <a href="#" class="text-indigo-600 hover:text-indigo-800 font-medium">
                View History <i class="fas fa-arrow-right ml-1"></i>
            </a>
        </div>
    </div>

    <!-- Quick Tip Section -->
    <div class="mt-12 bg-white p-6 rounded-lg shadow-md">
        <div class="text-indigo-600 text-4xl mb-4">
            <i class="fas fa-lightbulb"></i>
        </div>
        <h3 class="text-xl font-semibold mb-2">Quick Tip</h3>
        <p class="text-gray-600 mb-4">
            You'll get 5% discount when you order 5+ books. After 10 successful orders, you'll earn an additional 10% discount!
        </p>
    </div>
</div>