<!DOCTYPE html>
<html lang="en" class="light">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MetroBook</title>
    <!-- Tailwind CSS CDN with dark mode support -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        dark: {
                            100: '#e5e7eb',
                            200: '#d1d5db',
                            300: '#9ca3af',
                            400: '#6b7280',
                            500: '#4b5563',
                            600: '#374151',
                            700: '#1f2937',
                            800: '#111827',
                            900: '#0f172a',
                        }
                    }
                }
            }
        }
    </script>
    <!-- Font Awesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body,
        html {
            font-family: 'Inter', sans-serif;
        }

        /* Optionally, customize specific headings for better appearance */
        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            font-family: 'Inter', sans-serif;
            font-weight: 600;
        }

        /* Gradient Background for Header and Footer */
        .gradient-bg {
            background: linear-gradient(135deg, #c4c5c6 0%, #646364 100%);
        }

        .dark .gradient-bg {
            background: linear-gradient(135deg, #2c3e50 0%, #1a1a1a 100%);
        }

        /* Animation for button hover effects */
        .transition-scale {
            transition: transform 0.3s ease-in-out;
        }

        .transition-scale:hover {
            transform: scale(1.05);
        }

        /* Smooth theme transition */
        html {
            transition: background-color 0.3s ease, color 0.3s ease;
        }
    </style>
</head>

<body class="bg-gray-50 dark:bg-dark-900 text-gray-800 dark:text-dark-100">

    <!-- Main Layout Container -->
    <div class="min-h-screen flex flex-col">

        <!-- Header Section (Gradient + Sticky Navbar) -->
        <header class="gradient-bg dark:bg-dark-800 text-black dark:text-white shadow-lg sticky top-0 z-10">
            <div class="container mx-auto px-6 py-6">
                <div class="flex justify-between items-center">
                    <a href="/" class="text-2xl font-bold flex items-center space-x-2">
                        <i class="fas fa-book-open"></i>
                        <span>MetroBook</span>
                    </a>

                    <div class="flex items-center space-x-6">
                        <!-- Show cart icon only when authenticated -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a href="@Url.Action("Index", "Cart")"
                                class=" p-2 rounded-full hover:text-gray-200 dark:hover:text-dark-700 transition-colors">
                                <!-- Shopping cart icon -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
                                    stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13l-1.2 6h13.4M6 19a2 2 0 104 0 2 2 0 00-4 0zm10 0a2 2 0 104 0 2 2 0 00-4 0z" />
                                </svg>
                            </a>
                        }

                        <!-- Theme Toggle Button -->
                        <button id="theme-toggle"
                            class="p-2 rounded-full hover:bg-gray-200 dark:hover:bg-dark-700 transition-colors">
                            <i class="fas fa-moon dark:hidden"></i>
                            <i class="fas fa-sun hidden dark:block"></i>
                        </button>

                        <!-- User Authentication Links -->
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="flex items-center space-x-2">
                                <i class="fas fa-user-circle text-lg"></i>
                                <span class="text-sm">Welcome, @User.Identity.Name!</span>
                            </div>
                            <a href="/Account/Logout" class="hover:text-gray-200 dark:hover:text-dark-300 transition">
                                <i class="fas fa-sign-out-alt"></i> Logout
                            </a>
                        }
                        else
                        {
                            <a href="/Account/Login" class="hover:text-gray-200 dark:hover:text-dark-300 transition">
                                <i class="fas fa-sign-in-alt"></i> Login
                            </a>
                            <a href="/Account/Register" class="hover:text-gray-200 dark:hover:text-dark-300 transition">
                                <i class="fas fa-user-plus"></i> Register
                            </a>
                        }
                    </div>
                </div>
            </div>
        </header>


        <!-- Main Content Section -->
        <main class="flex-grow container mx-auto mt-0 max-w-full">
            @RenderBody()
        </main>

        <!-- Footer Section (Matching Gradient Background) -->
        <footer class="gradient-bg dark:bg-dark-800 text-white dark:text-dark-100 py-8 mt-12">
            <div class="container mx-auto text-center">
                <div class="space-y-4">
                    <h4 class="text-lg font-semibold">Stay Connected</h4>
                    <div class="flex justify-center space-x-4">
                        <a href="#"
                            class="text-white dark:text-dark-100 hover:text-gray-300 dark:hover:text-dark-300 transition">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="#"
                            class="text-white dark:text-dark-100 hover:text-gray-300 dark:hover:text-dark-300 transition">
                            <i class="fab fa-twitter"></i>
                        </a>
                        <a href="#"
                            class="text-white dark:text-dark-100 hover:text-gray-300 dark:hover:text-dark-300 transition">
                            <i class="fab fa-instagram"></i>
                        </a>
                    </div>
                </div>
                <div class="mt-6 text-sm">
                    &copy; @DateTime.Now.Year - MetroBook - All rights reserved
                </div>
            </div>
        </footer>

    </div>

    <!-- Theme Toggle JavaScript -->
    <script>
        const themeToggle = document.getElementById('theme-toggle');
        const html = document.documentElement;

        // Check for saved theme preference or use system preference
        const savedTheme = localStorage.getItem('theme') ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

        // Apply the saved theme
        html.classList.add(savedTheme);

        themeToggle.addEventListener('click', () => {
            html.classList.toggle('dark');
            const isDark = html.classList.contains('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
    </script>



    <!-- Render any additional JavaScript -->
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>