@model OnlineBookStore.Controllers.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="max-w-md mx-auto my-12 bg-white p-8 rounded-lg shadow-lg">
    <h2 class="text-2xl font-bold text-center text-gray-800 mb-6">
        <i class="fas fa-user-plus mr-2"></i> Create New Account
    </h2>

    <form asp-action="Register" method="post" class="space-y-6">
        <div>
            <label asp-for="Username" class="block text-sm font-medium text-gray-700">
                <i class="fas fa-user mr-1"></i> Username
            </label>
            <input asp-for="Username" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" />
            <span asp-validation-for="Username" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="Email" class="block text-sm font-medium text-gray-700">
                <i class="fas fa-envelope mr-1"></i> Email
            </label>
            <input asp-for="Email" type="email" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" />
            <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="FirstName" class="block text-sm font-medium text-gray-700">
                <i class="fas fa-id-card mr-1"></i> First Name
            </label>
            <input asp-for="FirstName" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" />
            <span asp-validation-for="FirstName" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="LastName" class="block text-sm font-medium text-gray-700">
                <i class="fas fa-id-card mr-1"></i> Last Name
            </label>
            <input asp-for="LastName" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" />
            <span asp-validation-for="LastName" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="Password" class="block text-sm font-medium text-gray-700">
                <i class="fas fa-lock mr-1"></i> Password
            </label>
            <input asp-for="Password" type="password" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" />
            <span asp-validation-for="Password" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700">
                <i class="fas fa-lock mr-1"></i> Confirm Password
            </label>
            <input asp-for="ConfirmPassword" type="password" class="mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" />
            <span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <button type="submit" class="w-full gradient-bg text-white py-2 px-4 rounded-md hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition">
                <i class="fas fa-user-plus mr-2"></i> Register
            </button>
        </div>
    </form>

    <div class="mt-6 text-center">
        <p class="text-sm text-gray-600">
            Already have an account?
            <a asp-action="Login" class="font-medium text-indigo-600 hover:text-indigo-500">
                <i class="fas fa-sign-in-alt mr-1"></i> Login here
            </a>
        </p>
    </div>
</div>