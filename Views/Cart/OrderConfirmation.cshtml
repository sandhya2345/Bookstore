@model OnlineBookStore.Models.Order
@{
    ViewData["Title"] = "Order Confirmation";
}

<!-- SweetAlert2 for popup message -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="max-w-6xl mx-auto mt-12 bg-white border  overflow-hidden flex flex-col md:flex-row">
    <!-- Left: Message Panel -->
    <div class="md:w-1/3 bg-gradient-to-br from-blue-100 to-blue-200 p-8 flex flex-col justify-center items-center text-center">
        <h2 class="text-3xl font-extrabold text-gray-800 mb-4">Order Confirmed!</h2>
        <p class="text-gray-700 text-md mb-2">Thank you for shopping at <span class="font-semibold">Online Book Store</span>!</p>
        <p class="text-gray-600 text-sm">A confirmation email has been sent to your registered address.</p>
    </div>

    <!-- Right: Receipt Details -->
    <div class="md:w-2/3 p-8 bg-gray-50">
        <div class="mb-6 border-b pb-4">
            <h3 class="text-xl font-semibold text-gray-900 mb-1">Receipt - Order #@Model.OrderId</h3>
            <p class="text-sm text-gray-500">@Model.OrderDate.ToString("MMMM dd, yyyy")</p>
            <p class="text-sm text-gray-500">Claim Code: <span class="font-mono text-indigo-600">@Model.ClaimCode</span></p>
        </div>

        <!-- Items List -->
        <div>
            <h4 class="text-lg font-semibold text-gray-800 mb-3">Items Ordered</h4>
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left text-gray-700">
                    <thead class="bg-gray-200 text-gray-600 uppercase">
                        <tr>
                            <th class="py-3 px-4">Book</th>
                            <th class="py-3 px-4">Qty</th>
                            <th class="py-3 px-4">Unit Price</th>
                            <th class="py-3 px-4">Total</th>
                        </tr>
                    </thead>
                    <tbody class="bg-white">
                        @foreach (var item in Model.OrderItems)
                        {
                            <tr class="border-b hover:bg-gray-50">
                                <td class="py-3 px-4">@item.Book.Title</td>
                                <td class="py-3 px-4">@item.Quantity</td>
                                <td class="py-3 px-4">Rs. @item.UnitPrice.ToString("F2")</td>
                                <td class="py-3 px-4">Rs. @(item.Quantity * item.UnitPrice).ToString("F2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Summary Section -->
        <div class="mt-6 text-sm text-gray-700 space-y-2">
            <p><strong>Subtotal:</strong> Rs. @Model.TotalAmount.ToString("F2")</p>
            <p><strong>Discount:</strong> <span class="text-yellow-600">Rs. @Model.DiscountAmount.ToString("F2")</span></p>
        </div>

        <!-- Total Section -->
        <div class="mt-6 border-t pt-4 flex justify-between items-center">
            <div class="text-sm text-gray-600">
                <span class="bg-gray-100 px-2 py-1 rounded">Paid with Card •••• 2020</span>
            </div>
            <div class="text-2xl font-bold text-gray-900">
                Total: Rs. @Model.FinalAmount.ToString("F2")
            </div>
        </div>

        <!-- Actions -->
        <div class="mt-8 flex flex-col sm:flex-row justify-end gap-4">
            <a href="/" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-6 py-2 rounded-lg text-center transition duration-200">
                🔙 Back to Home
            </a>
            <button onclick="window.print()" class="bg-gray-700 hover:bg-gray-800 text-white font-medium px-6 py-2 rounded-lg transition duration-200">
                🖨️ Print Order
            </button>
        </div>
    </div>
</div>

<!-- SweetAlert2 popup -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        Swal.fire({
            icon: 'success',
            title: 'Order Processing!',
            text: 'Please wait for the successful order verification',
            confirmButtonColor: '#3085d6',
            confirmButtonText: 'Got it',
            background: '#f0f9ff'
        });
    });
</script>
