@model OnlineBookStore.Models.Order
@{
    ViewData["Title"] = "Order Confirmation";
}

<!-- SweetAlert2 for popup message -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="max-w-6xl mx-auto mt-10 bg-white overflow-hidden border border-gray-200 flex flex-col md:flex-row">
    <!-- Left Side (Message Panel) -->
    <div class="bg-white md:w-1/3 p-8 flex flex-col justify-center items-center">
        <h2 class="text-2xl md:text-3xl font-bold text-gray-800 text-center mb-4">Your order has been placed.</h2>
        <p class="text-md text-gray-600 text-center">Thank you for ordering from Online Book Store! You will receive a confirmation email shortly.</p>
    </div>

    <!-- Right Side (Receipt Details) -->
    <div class="md:w-2/3 bg-gray-200 p-8">
        <div class="flex justify-between items-start mb-6">
            <div>
                <h3 class="text-xl font-semibold text-gray-800 mb-1">Receipt for Order #@Model.OrderId</h3>
                <p class="text-sm text-gray-500">@Model.OrderDate.ToString("MMMM dd, yyyy")</p>
                <p class="text-sm text-gray-500">Claim Code: <span class="font-mono text-indigo-600">@Model.ClaimCode</span></p>
            </div>
        </div>

        <h4 class="text-md font-semibold text-gray-700 mb-2">Items Ordered</h4>
        <table class="w-full mb-6">
            <thead class="text-gray-500 border-b text-sm">
                <tr>
                    <th class="text-left py-2">Book</th>
                    <th class="text-left py-2">Qty</th>
                    <th class="text-left py-2">Unit Price</th>
                    <th class="text-left py-2">Total</th>
                </tr>
            </thead>
            <tbody class="text-sm text-gray-800">
                @foreach (var item in Model.OrderItems)
                {
                    <tr class="border-b">
                        <td class="py-2">@item.Book.Title</td>
                        <td class="py-2">@item.Quantity</td>
                        <td class="py-2">Rs. @item.UnitPrice.ToString("F2")</td>
                        <td class="py-2">Rs. @(item.Quantity * item.UnitPrice)</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="text-sm text-gray-700 mb-4 space-y-1">
            <p><strong>Subtotal:</strong> Rs. @Model.TotalAmount.ToString("F2")</p>
            <p><strong>Discount:</strong> <span class="text-yellow-600">Rs. @Model.DiscountAmount.ToString("F2")</span></p>
    
        </div>

        <div class="border-t pt-4 mt-4 flex justify-between items-center">
            <div class="text-sm flex items-center space-x-2">
                <span class="bg-gray-200 px-2 py-1 rounded">Paid with Card •••• 2020</span>
            </div>
            <div class="text-xl font-bold text-gray-900">
                Total: Rs. @Model.FinalAmount.ToString("F2")
            </div>
        </div>

        <div class="mt-8 flex justify-end space-x-4">
            <a href="/" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-medium px-6 py-2 rounded-lg transition-all duration-200">
                🔙 Back to Home
            </a>

            <button onclick="window.print()" class="inline-block bg-gray-700 hover:bg-gray-800 text-white font-medium px-6 py-2 rounded-lg transition-all duration-200">
                🖨️ Print Order
            </button>
        </div>
    </div>
</div>

<!-- SweetAlert2 popup once the page loads -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        Swal.fire({
            icon: 'success',
            title: 'Order Processing!',
            text: 'Please wait for the successful order verification',
            confirmButtonColor: '#3085d6',
            confirmButtonText: 'Got it'
        });
    });
</script>
