@model OnlineBookStore.Models.Order
@{
    ViewData["Title"] = "Order Confirmation";
}

<!-- SweetAlert2 for popup message -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="max-w-3xl mx-auto p-8 bg-white shadow-lg rounded-3xl mt-8 border border-gray-200">
    <div class="text-center">
        <h2 class="text-4xl font-semibold text-green-600 mb-2">Thank You for Your Order!</h2>
        <p class="text-lg text-gray-700">A confirmation email has been sent to your registered email address.</p>
    </div>

    <div class="border-t border-gray-200 mt-8 pt-8">
        <div class="mb-4">
            <p class="text-lg text-gray-800"><strong>📦 Order Number:</strong> <span class="font-semibold text-gray-900">@Model.OrderId</span></p>
            <p class="text-lg text-gray-800"><strong>📅 Date:</strong> <span class="font-semibold text-gray-900">@Model.OrderDate.ToString("MMMM dd, yyyy")</span></p>
            <p class="text-lg text-gray-800"><strong>🔐 Claim Code:</strong> <span class="font-mono bg-gray-100 px-2 py-1 rounded text-indigo-600">@Model.ClaimCode</span></p>
        </div>

        <h3 class="text-2xl font-semibold text-gray-800 mb-4">🛒 Items Ordered</h3>
        <table class="w-full table-auto border border-gray-300 mb-6 rounded-lg overflow-hidden">
            <thead class="bg-gray-100 text-gray-700">
                <tr>
                    <th class="text-left px-4 py-3 border">Book</th>
                    <th class="text-left px-4 py-3 border">Quantity</th>
                    <th class="text-left px-4 py-3 border">Unit Price</th>
                    <th class="text-left px-4 py-3 border">Total</th>
                </tr>
            </thead>
            <tbody class="text-gray-800">
                @foreach (var item in Model.OrderItems)
                {
                    <tr>
                        <td class="border px-4 py-3">@item.Book.Title</td>
                        <td class="border px-4 py-3">@item.Quantity</td>
                        <td class="border px-4 py-3">Rs. @item.UnitPrice.ToString("F2")</td>
                        <td class="border px-4 py-3">Rs. @(item.Quantity * item.UnitPrice)</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="text-right text-gray-800">
            <p class="mb-1 text-lg"><strong>Subtotal:</strong> Rs. @Model.TotalAmount.ToString("F2")</p>
            <p class="mb-1 text-lg text-yellow-600"><strong>Discount:</strong> Rs. @Model.DiscountAmount.ToString("F2")</p>
            <p class="text-xl font-bold"><strong>Total Payable:</strong> Rs. @Model.FinalAmount.ToString("F2")</p>
        </div>
    </div>

    <div class="mt-12 text-center">
        <a href="/" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-medium px-6 py-3 rounded-lg transition-all duration-200">
            🔙 Back to Home
        </a>

        <!-- Print Button -->
        <button onclick="window.print()" class="ml-4 inline-block bg-gray-600 hover:bg-gray-700 text-white font-medium px-6 py-3 rounded-lg transition-all duration-200">
            🖨️ Print Order
        </button>
    </div>
</div>

<!-- SweetAlert2 popup once the page loads -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        Swal.fire({
            icon: 'success',
            title: 'Order Confirmed!',
            text: 'We’ve sent a confirmation email with your order details.',
            confirmButtonColor: '#3085d6',
            confirmButtonText: 'Got it'
        });
    });
</script>
