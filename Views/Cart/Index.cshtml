@model List<OnlineBookStore.Models.ShoppingCart>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


@{
    ViewData["Title"] = "Your Cart";

    int totalBooks = Model.Sum(item => item.Quantity);
    decimal subtotal = Model.Sum(item => item.Quantity * item.Book.Price);
    decimal discount = 0;
    if (totalBooks >= 5) { discount += subtotal * 0.05m; }
    if ((bool)(ViewBag.IsLoyalCustomer ?? false)) { discount += subtotal * 0.10m; }
    decimal totalAfterDiscount = subtotal - discount;
}

<div class="container mx-auto px-4 py-10">
    <h2 class="text-2xl font-semibold text-gray-800 mb-8 text-left">Shopping Cart (@totalBooks)</h2>

    @if (!Model.Any())
    {
        <p class="text-gray-500 text-center">Your cart is empty. Start adding books!</p>
    }
    else
    {
        <form asp-action="Checkout" method="post" id="cartForm">

            @Html.AntiForgeryToken()

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Cart Items -->
                <div class="lg:col-span-2 space-y-8">
                    @foreach (var item in Model)
                    {
                       <div class="flex flex-col md:flex-row items-center border-b pb-6 hover:bg-gray-50 transition duration-300 ease-in-out">
                        <div class="flex items-center space-x-4">
                            <input type="checkbox"
                            name="selectedItems"
                            value="@item.CartId"
                            class="select-item self-center transform scale-125"
                             data-price="@item.Book.Price"
                              data-quantity="@item.Quantity" />
                              
                               <img src="@item.Book.CoverImageUrl"
                                alt="@item.Book.Title"
                                class="w-28 h-36 object-cover rounded-sm shadow-md" />
                        </div>

    <!-- Book Info -->
    <div class="ml-0 md:ml-6 mt-4 md:mt-0 flex-1">
        <h3 class="text-xl font-semibold text-gray-800">@item.Book.Title</h3>
        <p class="text-gray-600">by @item.Book.Author</p>

        <div class="mt-3 flex items-center space-x-2">
            <span class="border rounded px-2 py-1 text-sm cursor-pointer bg-gray-200 hover:bg-gray-300 transition"
                  onclick="updateQuantity(@item.CartId, -1)">-</span>
            <span class="px-2 text-lg font-medium" data-cart-id="@item.CartId">@item.Quantity</span>
            <span class="border rounded px-2 py-1 text-sm cursor-pointer bg-gray-200 hover:bg-gray-300 transition"
                  onclick="updateQuantity(@item.CartId, 1)">+</span>
        </div>

        <p class="mt-3 text-lg font-medium text-gray-800">Rs. @(item.Book.Price * item.Quantity)</p>

        <div class="mt-2 text-sm text-blue-600 flex items-center space-x-4">
           <button type="submit"
        name="cartId"
        value="@item.CartId"
        formaction="@Url.Action("RemoveFromCart")"
        formmethod="post"
        onclick="return confirm('Are you sure you want to remove this item?');"
        class="text-red-600 hover:text-red-800">
    <i class="fas fa-trash-alt"></i> Remove
</button>

            <a href="#" class="text-sm text-blue-600 hover:underline">Add To Wishlist</a>
        </div>
    </div>
</div>

                    }

                    <div class="mt-6 text-center">
                        <a  href="@Url.Action("Browse", "Books")"  class="text-sm text-blue-600 hover:underline flex justify-center items-center">
                            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" stroke-width="2"
                                viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                            </svg>
                            Continue Shopping
                        </a>
                    </div>
                </div>

                <!-- Order Summary -->
                <div class="bg-white border rounded-lg shadow-lg p-6 h-fit">
                    <h3 class="text-2xl font-semibold mb-6 text-gray-800">Order Summary</h3>
                    <!-- Subtotal -->
                    <div class="flex justify-between mb-4">
                        <span class="text-lg font-medium text-gray-700">Subtotal</span>
                        <span id="subtotal" class="text-lg font-semibold text-gray-800">Rs. 0.00</span>
                    </div>

                    <!-- Discount -->
                    <div class="text-sm text-green-600 mb-4" id="discount-info" style="display:none;"></div>

                    <!-- Total -->
                    <div class="flex justify-between mt-4 border-t pt-4 font-semibold text-lg">
                        <span>Total</span>
                        <span id="total" class="text-xl text-gray-800">Rs. 0.00</span>
                    </div>

                    <!-- Gift Wrap -->
                    <div class="mt-4 flex items-start space-x-2">
                        <input type="checkbox" class="mt-1" />
                        <span class="text-sm">Is this a gift? <br /><span class="text-gray-500">+ Rs. 15 for gift wrap</span></span>
                    </div>

                    <div class="mt-4 text-sm text-gray-600">
                        Discounts can be applied at the next window. <br />
                        Shipping costs will be calculated at checkout.
                    </div>

                    <div class="mt-6 text-sm font-medium text-gray-700">
                        <span class="inline-block mr-2">🎟</span> Have a discount coupon? Apply it in the next step.
                    </div>

                    <button type="submit" class="mt-6 w-full bg-blue-600 text-white py-2 px-4 rounded-lg hover:bg-blue-700 transition duration-300 ease-in-out">
                        PROCEED TO CHECKOUT
                    </button>
                </div>
            </div>
        </form>
    }
</div>

<!-- JavaScript for quantity update -->
<script>
    function updateQuantity(cartId, change) {
        fetch('/Cart/UpdateQuantity', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': document.querySelector('[name="__RequestVerificationToken"]').value
            },
            body: JSON.stringify({ cartId, change })
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const quantitySpan = document.querySelector(`span[data-cart-id='${cartId}']`);
                    if (quantitySpan) {
                        quantitySpan.textContent = data.newQuantity;
                        location.reload(); // Refresh to update subtotal and discount
                    }
                }
            });
    }
</script>

<script>
    function calculateSummary() {
        const checkboxes = document.querySelectorAll('.select-item');
        let subtotal = 0;
        let totalBooks = 0;

        checkboxes.forEach(cb => {
            if (cb.checked) {
                const price = parseFloat(cb.dataset.price);
                const quantity = parseInt(cb.dataset.quantity);
                subtotal += price * quantity;
                totalBooks += quantity;
            }
        });

        let discount = 0;
        let discountText = "";

        if (totalBooks >= 5) {
            discount += subtotal * 0.05;
            discountText += "✔ 5% discount for 5+ books ";
        }

        const isLoyal = @((bool)(ViewBag.IsLoyalCustomer ?? false) ? "true" : "false");
        if (isLoyal) {
            discount += subtotal * 0.10;
            discountText += "✔ 10% loyalty discount";
        }

        const total = subtotal - discount;

        // Update the DOM
        document.getElementById('subtotal').textContent = `Rs. ${subtotal.toFixed(2)}`;
        document.getElementById('total').textContent = `Rs. ${total.toFixed(2)}`;

        const discountDiv = document.getElementById('discount-info');
        if (discount > 0) {
            discountDiv.style.display = 'block';
            discountDiv.textContent = discountText;
        } else {
            discountDiv.style.display = 'none';
        }
    }

    // Attach event listeners
    document.querySelectorAll('.select-item').forEach(cb => {
        cb.addEventListener('change', calculateSummary);
    });

    // Initial run (optional)
    calculateSummary();
</script>

<script>
    // Intercept form submission
    document.getElementById('cartForm').addEventListener('submit', function (e) {
        const selectedItems = document.querySelectorAll('.select-item:checked');

        if (selectedItems.length === 0) {
            e.preventDefault(); // Prevent form submission

            Swal.fire({
                icon: 'warning',
                title: 'No Items Selected',
                text: 'Please select at least one item before proceeding to checkout.',
                confirmButtonColor: '#3085d6'
            });
        }
    });
</script>
